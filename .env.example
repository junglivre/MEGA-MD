# MEGA-MD environment example
# Copy this file to .env and fill in the values you need.

# Connection
SESSION_ID=
PAIRING_NUMBER=
PORT=5000

# Bot identity
BOT_NAME=MEGA-MD
OWNER=jung
BOT_OWNER=jung
OWNER_NUMBER=923000000000
OWNER_LID=
AUTHOR=
PACKNAME=MEGA-MD
PACK_OWNER=Bixo
DESCRIPTION=High performance multi-device WhatsApp bot
PREFIXES=.,!,/,#
COMMAND_MODE=public
TIMEZONE=Asia/Karachi
DEFAULT_LANGUAGE=pt-BR

# Optional newsletter branding
NEWSLETTER_JID=
NEWSLETTER_NAME=
NEWSLETTER_SERVER_MESSAGE_ID=-1

# Storage and performance
MAX_STORE_MESSAGES=100
CLEANUP_INTERVAL=3600000
STORE_WRITE_INTERVAL=10000

# Automatic ZIP backups
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION=7
BACKUP_DIR=backups

# Groq AI and Whisper transcription
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_REASONING=medium
# Optional hard limits; size defaults are 300/600/1000 tokens and 1200/2400/4800 characters
GROQ_VISION_MAX_TOKENS=
GROQ_VISION_MAX_CHARS=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Additional instructions; use \n for line breaks inside this value
GROQ_CHAT_INSTRUCTIONS=
# Response length: short, medium or big
GROQ_CHAT_RESPONSE_SIZE=medium
GROQ_CHAT_MAX_TOKENS=700
GROQ_CHAT_TEMPERATURE=0.7
GROQ_CHAT_HISTORY_LIMIT=20

# QuotLy-compatible renderer (optional)
QUOTE_API_URL=https://quoapi.jung.moe/generate
# Last.fm scrobble card
LASTFM_API_KEY=
LASTFM_API_URL=https://ws.audioscrobbler.com/2.0/

# Database (optional; leave empty for the default JSON storage)
MONGO_URL=
POSTGRES_URL=
MYSQL_URL=
DB_URL=

# YouTube cookies for .play/.song/.video (optional; requires yt-dlp on the host)
# Prefer the `.ytcookies set` WhatsApp command (owner-only) — it stores the
# cookies.txt content in the database above, which survives redeploys.
# This path is only a fallback used when no cookie was saved via WhatsApp yet;
# point it at a Netscape-format cookies.txt file on disk (a few KB, fits fine
# either way — the file path is simpler to rotate manually over SSH).
YOUTUBE_COOKIES_FILE=

# Other APIs (optional)
GIPHY_API_KEY=
REMOVEBG_KEY=
NEOXR_KEY=
ZENZAPIS_KEY=

# Links and branding (optional)
CHANNEL_LINK=https://whatsapp.com/channel/0029VagJIAr3bbVBCpEkAM07
UPDATE_URL=https://github.com/junglivre/MEGA-MD/archive/refs/heads/main.zip
YT_CHANNEL=GlobalTechInfo
